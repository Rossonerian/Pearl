#!/usr/bin/env bash
# Pearl OpenHistory Structural Telemetry & Profile Collector
# Collects macOS structural context + User's personal profile in < 30ms
set -uo pipefail

# 1. Circadian Phase & Time
hour="$(date +%H)"
day_name="$(date +%A)"
time_str="$(date '+%I:%M %p')"

phase="Day"
if [ "$hour" -ge 5 ] && [ "$hour" -lt 12 ]; then
    phase="Morning"
elif [ "$hour" -ge 12 ] && [ "$hour" -lt 18 ]; then
    phase="Afternoon"
elif [ "$hour" -ge 18 ] && [ "$hour" -lt 23 ]; then
    phase="Evening"
else
    phase="Late Night"
fi

# 2. Hardware Power & Battery Telemetry
batt_raw="$(pmset -g batt 2>/dev/null | grep -Eo '[0-9]+%' | head -n 1 || echo 'unknown')"
batt_state="on battery"
if pmset -g batt 2>/dev/null | grep -iqE 'ac power|charging'; then
    batt_state="charging"
fi

# 3. OpenHistory Frontmost App & Window Context (~20ms)
front_app="Unknown"
front_win="None"
app_info="$(osascript -e '
try
    tell application "System Events"
        set p to first process whose frontmost is true
        set appName to name of p
        set winTitle to "Main Window"
        try
            set winTitle to name of front window of p
        end try
        return appName & "|||" & winTitle
    end tell
on error
    return "Desktop|||Finder"
end try' 2>/dev/null || echo "Desktop|||Finder")"

if [ -n "$app_info" ]; then
    front_app="${app_info%%|||*}"
    front_win="${app_info##*|||}"
fi

# 4. Media "Now Playing" Context (Music or Spotify)
now_playing=""
music_track="$(osascript -e '
try
    if application "Music" is running then
        tell application "Music"
            if player state is playing then
                return (name of current track) & " by " & (artist of current track)
            end if
        end tell
    end if
    if application "Spotify" is running then
        tell application "Spotify"
            if player state is playing then
                return (name of current track) & " by " & (artist of current track)
            end if
        end tell
    end if
end try
return ""' 2>/dev/null || echo "")"

if [ -n "$music_track" ]; then
    now_playing="Music: \"$music_track\""
fi

# 5. Scratchpad Count
note_count=0
if [ -f "$HOME/.pearl/scratchpad.md" ]; then
    note_count="$(grep -c '^- \[' "$HOME/.pearl/scratchpad.md" 2>/dev/null || echo 0)"
fi

# 6. User Profile Summary & Learned Rules
learned_rules=""
profile_file="$HOME/.pearl/USER_PROFILE.md"
if [ -f "$profile_file" ]; then
    learned_rules="$(sed -n '/## Learned Preferences & Dynamic Instructions/,$p' "$profile_file" 2>/dev/null | grep '^- ' | sed 's/^- //' | tr '\n' '; ' | sed -e 's/[; ]*$//' || echo "")"
fi

# 7. Pearl Dynamic Personality State (< 5ms)
personality_state=""
if [ -x "$HOME/.local/bin/pearl-personality" ]; then
    personality_state="$("$HOME/.local/bin/pearl-personality" --state 2>/dev/null || echo "")"
fi

echo "[MacBook Neo Telemetry: Day: $day_name, Time: $time_str ($phase), Battery: $batt_raw ($batt_state), Focused App: $front_app (Window: $front_win)${now_playing:+, $now_playing}, Active Notes: $note_count]"
echo "[User Context: Name: User | Role: Student & Aspiring Software Engineer | Tone: Casual warmth + high technical depth | Projects: Axiom26, BET_Catcher, GlassMail | Learned Rules: ${learned_rules:-Default}]"
if [ -n "$personality_state" ]; then
    echo "$personality_state"
fi
